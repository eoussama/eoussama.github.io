---
import type { Lang } from "~/i18n/langs";
import type { Schema } from "~/lib/schema";

import naskh400 from "@fontsource/noto-naskh-arabic/arabic-400.css?inline";
import naskh500 from "@fontsource/noto-naskh-arabic/arabic-500.css?inline";
import jp400 from "@fontsource/noto-serif-jp/400.css?url";
import jp500 from "@fontsource/noto-serif-jp/500.css?url";
import newsreaderItalic from "~/assets/fonts/newsreader-latin-italic.woff2?url";
import newsreaderLatin from "~/assets/fonts/newsreader-latin-normal.woff2?url";
import Consent from "~/components/Consent.astro";
import Drawer from "~/components/Drawer.astro";
import Header from "~/components/Header.astro";
import Palette from "~/components/Palette.astro";
import Shortcuts from "~/components/Shortcuts.astro";
import { langInfo, LANGS } from "~/i18n/langs";
import { ui } from "~/i18n/ui";
import { localized, url } from "~/lib/url";

import "~/styles/fonts.css";
import "~/styles/global.css";



interface Props {
  lang: Lang;
  /** The page's path without the language prefix, "" for the home page. */
  path?: string;
  title: string;
  description: string;
  /** Whether the page has the greeting, which the command menu can cycle. */
  hello?: boolean;
  /** Keeps search engines away, and leaves out the links to other languages. */
  noindex?: boolean;
  /** How the page shows when shared: a site page, or an article (a post). */
  kind?: "website" | "article";
  /** What the way back names this page from the next one: its name, or the title. */
  label?: string;
  /** What search engines read about the page beside its text (lib/schema.ts). */
  schema?: Schema;
}

const { lang, path = "", title, description, hello = false, noindex = false, kind = "website", label, schema } = Astro.props;
/** Google Analytics' measurement ID; without one, nothing is asked and nothing loads. */
const gaId = import.meta.env.PUBLIC_GA_ID ?? "";
const LOCALES: Record<Lang, string> = { ar: "ar_MA", ary: "ar_MA", en: "en_GB", fr: "fr_FR", es: "es_ES", it: "it_IT", ja: "ja_JP" };
const t = ui(lang);
const info = langInfo(lang);
const alternates = Object.fromEntries(LANGS.map(l => [l.code, localized(l.code, path)]));
const codes = LANGS.map(l => l.code);
const absolute = (href: string) => new URL(href, Astro.site).href;
// Search engines take a language's two-letter code, which Darija has none of: they
// know it as the Arabic of Morocco.
const hreflang = (code: Lang) => (code === "ary" ? "ar-MA" : code);

/*
 * Pages of the site are prerendered as a link is pointed at (or touched), so they open
 * at once. Not the lists (they open over the page), new tabs, files, or other versions.
 */
const base = import.meta.env.BASE_URL;
const speculation = JSON.stringify({
  prerender: [{
    where: {
      and: [
        { href_matches: `${base}*` },
        { not: { selector_matches: "[data-drawer], [target=_blank], [download]" } },
        { not: { href_matches: `${base}*.(pdf|xml|txt|svg|jpg)` } },
        ...(base === "/" ? [{ not: { href_matches: "/v/*" } }] : []),
      ],
    },
    eagerness: "moderate",
  }],
});
---

<!doctype html>
<html lang={lang} dir={info.dir} data-lang={lang} data-theme="auto" data-mode="light" data-label={noindex ? undefined : (label ?? title)}>
  <head>
    <!-- Hello. There's a shorter way to find me: npx ouss -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf7f2" />
    {/*
      Before the first paint: the saved theme (no flash), the keyboard shortcut's
      label, whether to play the entrance again, and, on English pages, a first
      visit that follows the browser's language.
    */}
    <script is:inline define:vars={{ lang, alternates, codes, redirect: !noindex }}>
      const d = document.documentElement;

      function read(store, key) {
        try {
          return store.getItem(key);
        }
        catch {
          return null;
        }
      }

      d.classList.add("js");

      let theme = read(localStorage, "theme");

      if (theme !== "light" && theme !== "dark") {
        theme = "auto";
      }

      const dark = theme === "dark" || (theme === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);

      d.dataset.theme = theme;
      d.dataset.mode = dark ? "dark" : "light";

      if (dark) {
        document.querySelector("meta[name=theme-color]").content = "#14161d";
      }

      // ?list=projects or ?list=posts opens the list drawer over the page.
      const list = { projects: "work", posts: "writing" }[new URLSearchParams(location.search).get("list")];

      if (list) {
        d.dataset.open = list;
      }

      if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
        d.classList.add("is-mac");
      }

      // The logo settling and the signature drawing play on every load and reload,
      // but not when moving from one page of the site to another, or back and forth.
      const nav = performance.getEntriesByType("navigation")[0];
      const fromHere = !!document.referrer && new URL(document.referrer).origin === location.origin;

      if (nav?.type === "back_forward" || (fromHere && nav?.type !== "reload")) {
        d.classList.add("is-seen", "sig-drawn");
      }
      else if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        // The text rises in as the page first shows: hold it back until it starts.
        d.dataset.rv = "pre";
      }

      // The 404 sends visitors on itself, keeping the address they asked for.
      if (lang === "en" && redirect) {
        let want = read(localStorage, "lang");

        for (const tag of want ? [] : navigator.languages || [navigator.language || ""]) {
          const full = String(tag).toLowerCase();

          want = codes.find(c => c === full) || codes.find(c => c === full.split("-")[0]);

          if (want) {
            break;
          }
        }

        if (want && want !== "en" && alternates[want]) {
          location.replace(alternates[want] + location.hash);
        }
      }
    </script>
    {/* For whoever opens the browser's console: the shorter way to find me. Its lavender
        is one that reads on a light console and a dark one alike (about 4:1 on both). */}
    <script is:inline define:vars={{ hello: t.consoleHello }}>
      // eslint-disable-next-line no-console -- the console is where it belongs.
      console.log(`%c${hello}`, "font: 600 15px/1.6 Georgia, serif; color: #7c6cf0");
    </script>
    <script is:inline type="speculationrules" set:html={speculation} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={absolute(localized(lang, path))} />}
    {!noindex && LANGS.map(l => <link rel="alternate" hreflang={hreflang(l.code)} href={absolute(alternates[l.code] ?? url())} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={absolute(localized("en", path))} />}
    <meta property="og:type" content={kind} />
    <meta property="og:site_name" content={t.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(localized(lang, path))} />
    <meta property="og:locale" content={LOCALES[lang]} />
    <meta property="og:image" content={absolute(url("og.jpg"))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OussamaEssamadi" />
    <meta name="twitter:creator" content="@OussamaEssamadi" />
    <meta name="author" content={t.name} />
    {schema && !noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />}
    <slot name="head" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={t.feed} href={localized(lang, "rss.xml")} />
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderItalic} as="font" type="font/woff2" crossorigin />
    {/* Arabic's font rules are a few lines: in the page, they cost no request before it is drawn. Japanese's are far larger, so linked. */}
    {info.dir === "rtl" && <style is:inline set:html={naskh400 + naskh500} />}
    {lang === "ja" && <link rel="stylesheet" href={jp400} />}
    {lang === "ja" && <link rel="stylesheet" href={jp500} />}
  </head>
  <body>
    {/* Behind everything, always painted, for the paper to blend with: see .ground in global.css. */}
    <div class="ground" aria-hidden="true"></div>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="page">
      <div class="col">
        {/* Printed, the page is a letter: the name at its head, the signature at its
            foot. Neither shows on screen. */}
        <div class="lh-head" aria-hidden="true"><p class="lh-name">{t.name}</p></div>
        <Header lang={lang} path={path}>
          <slot name="crumb" slot="crumb" />
        </Header>
        {/* The way back names the page you came from, not always the home page. Each page
            of the site visited in this tab is pushed on a trail; arriving at one already
            on it (back, or a link up) pops what came after. The crumb then leads to the
            page before this one, back through the history when that is where it is, so
            the page returns where it was left. Inline, so it is right before the first
            paint. A missing page (no label) is never on the trail.

            The trail is walked whenever the page is shown, not only when it is loaded: a
            page prepared in the background as a link is pointed at is not shown until it
            is opened, and a page put back from the browser's back/forward cache (the way
            back to the home page is one) loads nothing and runs nothing, so it would
            leave the trail as the page after it had left it. */}
        <script is:inline define:vars={{ lang, base: import.meta.env.BASE_URL, codes }}>
          (() => {
            const root = document.documentElement;
            const label = root.dataset.label;

            if (!label) {
              return;
            }

            // A page whatever its language: /p/fr/projects/x/ and /p/projects/x/ are one.
            const other = codes.filter(code => code !== "en").join("|");
            const keyOf = path => path.replace(new RegExp(`/p/(?:${other})/`), "/p/").replace(/\/p\/$/, "/");
            const hrefOf = (key) => {
              if (lang === "en") {
                return key;
              }

              return key === base ? `${base}p/${lang}/` : key.replace(`${base}p/`, `${base}p/${lang}/`);
            };

            const crumb = document.querySelector(".bar .crumb");
            // The crumb as the page was built: the site's name, leading home.
            const named = crumb && { text: crumb.textContent, href: crumb.getAttribute("href") };
            /** The page before this one on the trail, if there is one. */
            let back = null;

            /** Puts this page on the trail, popping what came after it, and points the crumb at the page before. */
            const walk = () => {
              let trail = [];

              try {
                trail = JSON.parse(sessionStorage.getItem("trail") || "[]");
              }
              catch {}

              const here = { key: keyOf(location.pathname), label };
              const at = trail.findIndex(step => step.key === here.key);

              trail = at >= 0 ? [...trail.slice(0, at), here] : [...trail, here].slice(-50);

              try {
                sessionStorage.setItem("trail", JSON.stringify(trail));
              }
              catch {}

              back = trail.at(-2) ?? null;

              if (!crumb) {
                return;
              }

              // The home page keeps the crumb as it is: the site's name, which turns into
              // the home page's own as the page changes. Any other is named by its label.
              if (back && back.key !== base) {
                crumb.textContent = back.label;
                crumb.href = hrefOf(back.key);
                crumb.style.viewTransitionName = "none";
              }
              else {
                crumb.textContent = named.text;
                crumb.setAttribute("href", named.href);
                crumb.style.removeProperty("view-transition-name");
              }
            };

            crumb?.addEventListener("click", (event) => {
              const entries = globalThis.navigation?.entries?.() ?? [];
              const before = entries[(globalThis.navigation?.currentEntry?.index ?? 0) - 1];

              if (back && before?.url && keyOf(new URL(before.url).pathname) === back.key && !event.metaKey && !event.ctrlKey && !event.shiftKey) {
                event.preventDefault();
                history.back();
              }
            });

            if (document.prerendering) {
              document.addEventListener("prerenderingchange", walk, { once: true });
            }
            else {
              walk();
            }

            addEventListener("pageshow", (event) => {
              if (event.persisted) {
                walk();
              }
            });
          })();
        </script>
        <main id="main">
          <slot />
        </main>
        <div class="lh-foot" aria-hidden="true"><img class="lh-sig" src={url("signature.svg")} width="250" height="105" alt="" decoding="async" fetchpriority="low" /></div>
      </div>
    </div>
    {/* What Safari on iOS reads to colour the status bar: see .sky in global.css. After
         the page, so it lies over the header's empty top edge. */}
    <div class="sky" aria-hidden="true"></div>
    {/* Beside the page rather than in it, so it stays put while the drawer moves the page aside. */}
    <slot name="aside" />
    {/* Far down a page, a way back up, ringed by how much of the page has been read: scripts/top.ts. */}
    <button type="button" class="to-top" aria-label={t.toTop} title={t.toTop} data-shown="false" tabindex="-1" hidden>
      <svg class="to-top-ring" width="44" height="44" viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="21" pathLength="1"></circle><circle class="to-top-read" cx="22" cy="22" r="21" pathLength="1"></circle></svg>
      <svg class="to-top-arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3.5M3.5 8 8 3.5 12.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <Drawer lang={lang} />
    <Palette lang={lang} path={path} hello={hello} consent={!!gaId} />
    <Shortcuts lang={lang} />
    {gaId && <Consent lang={lang} id={gaId} />}
    {/*
      Back from a project or post, its name returns to its place in the list: the
      list names it for the view transition as it is shown. This has to
      be in place before the first paint, so it runs here rather than in a bundled
      script.
    */}
    <script is:inline>
      // A page opened with its drawer showing: the page behind it is out of reach.
      if (document.documentElement.dataset.open) {
        document.querySelector(".page").inert = true;
        document.querySelector("#drawer").inert = false;
      }

      addEventListener("pagereveal", (event) => {
        // The same page in another language: its sections are named as the page left
        // behind named them (scripts/vt.ts), and each blurs into this language. The page
        // makes no entrance of its own, then or after.
        const langPart = /\/p\/(ar|ary|fr|es|it|ja)\//;
        const pageOf = (href) => {
          const path = new URL(href, location.href).pathname;

          return { page: path.replace(langPart, "/p/").replace(/\/p\/$/, "/"), lang: langPart.exec(path)?.[1] ?? "en" };
        };
        const came = globalThis.navigation?.activation?.from?.url;

        if (event.viewTransition && came) {
          const here = pageOf(location.href);
          const there = pageOf(came);

          if (here.page === there.page && here.lang !== there.lang) {
            const root = document.documentElement;
            const parts = [];

            document.querySelectorAll("main .row").forEach((row, i) => {
              const box = row.getBoundingClientRect();

              if (box.bottom > 0 && box.top < innerHeight) {
                parts.push([row, `lang-r${i}`]);
              }
            });

            root.classList.add("vt-lang", "lang-changed");
            parts.forEach(([el, name]) => el.style.setProperty("view-transition-name", name, "important"));
            event.viewTransition.finished.finally(() => {
              root.classList.remove("vt-lang");
              parts.forEach(([el]) => el.style.removeProperty("view-transition-name"));
            });

            return;
          }
        }

        // Arrived through a view transition: the page's own entrance waits for what travels.
        if (event.viewTransition) {
          document.documentElement.classList.add("vt-arrive");
        }

        const page = /\/(projects|blog)\/([^/]+)\/$/;
        const from = globalThis.navigation?.activation?.from?.url;
        const match = from && page.exec(new URL(from).pathname);

        if (!event.viewTransition || !match || page.test(location.pathname)) {
          return;
        }

        const shown = link => !link.closest("[inert], .crumb, .ck") && link.getClientRects().length > 0;
        const links = [...document.querySelectorAll(`a[href$="/${match[1]}/${match[2]}/"]`)];
        const link = links.find(l => shown(l) && l.closest(".dr")) ?? links.find(shown);
        const key = `${match[1]}-${match[2]}`;

        if (link) {
          link.style.viewTransitionName = `vt-name-${key}`;
          link.classList.add("vt-carry");
          event.viewTransition.finished.finally(() => {
            link.classList.remove("vt-carry");
            link.style.removeProperty("view-transition-name");
          });
        }
      });
    </script>
    <script>
      import "~/scripts/site";
      import "~/scripts/copy";
      import "~/scripts/palette";
      import "~/scripts/keys";
      import "~/scripts/tug";
      import "~/scripts/drawer";
      import "~/scripts/vt";
      import "~/scripts/top";
      import "~/scripts/minimap";
      import "~/scripts/chips";
      import "~/scripts/reveal";
      import "~/scripts/name";
      import "~/scripts/sign";
      import "~/scripts/logo";
      import "~/scripts/analytics";
    </script>
  </body>
</html>
