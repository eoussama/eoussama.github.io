---
import type { Lang } from "~/i18n/langs";

import { getCollection, render } from "astro:content";

import Ext from "~/components/Ext.astro";
import LinkIcon from "~/components/LinkIcon.astro";
import Minimap from "~/components/Minimap.astro";
import ProjectName from "~/components/ProjectName.astro";
import { ui } from "~/i18n/ui";
import Base from "~/layouts/Base.astro";
import { formatDate, formatSpan } from "~/lib/dates";
import { readingTime } from "~/lib/posts";
import { fullName, getProjects, pick, projectPath } from "~/lib/projects";
import { keepFrom } from "~/lib/tail";
import { localized } from "~/lib/url";



/**
 * A project's own page: its name and lead, then its role, what it is built with, its
 * source, its links, its story and the next project. Arriving from a list, the
 * project's name grows into the title.
 */
interface Props {
  lang: Lang;
  id: string;
}

const { lang, id } = Astro.props;
const t = ui(lang);
const projects = await getProjects();
const index = projects.findIndex(p => p.id === id);
const project = projects[index]!;
const next = projects[(index + 1) % projects.length]!;

// Most projects have no story; reading the collection, rather than asking for an entry, finds that out quietly.
const stories = await getCollection("stories", entry => entry.id.startsWith(`${id}/`));
const story = stories.find(entry => entry.id === `${id}/${lang}`) ?? stories.find(entry => entry.id === `${id}/en`);
const { Content, headings } = story ? await render(story) : { Content: null, headings: [] };
// The language the story is written in, English where it has not been translated.
const storyLang = (story?.id.split("/")[1] ?? "en") as Lang;
// As on a post, the map shows the story's sections when there are enough to need one.
const outline = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4);
const minutes = story ? readingTime(story.body) : 0;

// A project is written in English, as posts are in theirs: on another language's page
// its text says so, for screen readers and the fonts.
const en = lang === "en" ? {} : { lang: "en", dir: "ltr" };
const owned = project.repo?.startsWith("https://github.com/eoussama/") ?? false;
const role = project.role ? pick(project.role, lang) : (owned ? t.roleAuthor : "");
// What it is built with: its languages, then its frameworks and libraries. Each opens
// the list of projects filtered by it.
const chips = [
  ...project.languages.map(value => ({ group: "language", value })),
  ...project.tools.map(value => ({ group: "tool", value })),
];

// A long stack arrives whole, then folds to its first few and "+N" a moment later:
// pointing at the row, or a tap on the "+N", lays out the rest. Tabbing into the row
// opens it too.
const FOLD = 3;
const folded = chips.length > FOLD + 1;
const site = project.live?.replace(/^https?:\/\//, "").replace(/\/$/, "");
// A contribution's stars are the upstream project's, not a measure of the work.
const starsOf = (stats: { stars: number } | null) => (project.kind !== "contribution" && stats ? stats.stars : 0);

/**
 * A link's address as it reads on the page: no scheme, no "www.", no trailing slash.
 * On a narrow screen it may break after any slash.
 *
 * @param url - The address
 * @returns The short form
 */
function short(url: string): string {
  return url.replace(/^https?:\/\/(?:www\.)?/, "").replace(/\/$/, "");
}

/**
 * The short address up to its end, and its end: the second keeps the link's arrow
 * on its line.
 *
 * @param url - The address
 * @returns Its start, before its end
 */
function head(url: string): string {
  const text = short(url);

  return text.slice(0, cut(text));
}

/**
 * The end of a short address, kept on one line with the arrow.
 *
 * @param url - The address
 * @returns Its end
 */
function tail(url: string): string {
  const text = short(url);

  return text.slice(cut(text));
}

/**
 * Where a short address's end, kept on one line with the arrow, starts: after its
 * last slash, or later in a long last part.
 *
 * @param text - The short address
 * @returns Where its end starts
 */
function cut(text: string): number {
  const end = text.lastIndexOf("/") + 1;

  return end + keepFrom(text.slice(end));
}
---

<Base lang={lang} path={projectPath(project)} title={`${fullName(project)} · ${t.name}`} description={pick(project.blurb, lang)} label={fullName(project)}>
  <a slot="crumb" class="crumb" href={localized(lang)}>{t.name}</a>
  {outline.length >= 3 && <Minimap slot="aside" lang={lang} own={storyLang} headings={outline} />}

  <article class="project" style={`--vt-name: vt-name-projects-${id}`}>
    <section class="row first">
      <h2 class="lab" id="work"><a class="anchor" href="#work" aria-label={t.work + t.anchor}>{t.work}</a></h2>
      <div class="hero">
        <h1><span class="title"><ProjectName owner={project.owner} name={project.name} /></span></h1>
        <p class="lead rise" {...en}>{pick(project.long ?? project.blurb, lang)}</p>
      </div>
    </section>

    {role && (
      <section class="row rise" style="--d: 30ms">
        <h2 class="lab" id="role"><a class="anchor" href="#role" aria-label={t.role + t.anchor}>{t.role}</a></h2>
        <p class="val mut when" {...(project.role ? en : {})}>{role}</p>
      </section>
    )}

    {(project.started || project.active) && (
      <section class={role ? "row tight rise" : "row rise"} style="--d: 35ms">
        <h2 class="lab" id="timeline"><a class="anchor" href="#timeline" aria-label={t.timeline + t.anchor}>{t.timeline}</a></h2>
        <p class="val mut when">{
          project.started && project.active
            ? formatSpan(project.started, project.active, lang)
            : project.started
              ? t.since(formatDate(new Date(project.started), lang))
              : t.until(formatDate(new Date(project.active!), lang))
        }</p>
      </section>
    )}

    {Content && (
      <section class={role || project.started || project.active ? "row tight rise" : "row rise"} style="--d: 41ms">
        <h2 class="lab" id="reading-time"><a class="anchor" href="#reading-time" aria-label={t.readingTime + t.anchor}>{t.readingTime}</a></h2>
        <p class="val mut when">{t.readTime(minutes)}</p>
      </section>
    )}

    {chips.length > 0 && (
      <section class={role || project.started || project.active || Content ? "row tight rise" : "row rise"} style="--d: 45ms">
        <h2 class="lab" id="built-with"><a class="anchor" href="#built-with" aria-label={t.built + t.anchor}>{t.built}</a></h2>
        <ul class="val chips" data-fold={folded ? "" : undefined} data-open={folded ? "first" : undefined}>
          {chips.map(({ group, value }, i) => (
            <li style={`--i: ${i}`}><a class="chip" href={`?list=projects&${new URLSearchParams({ [group]: value })}`} data-drawer="work" data-filter dir="ltr">{value}</a></li>
          ))}
          {folded && (
            <li class="chips-more" style={`--i: ${FOLD}`}><button type="button" class="chip" aria-label={t.showAll(chips.length)} title={t.showAll(chips.length)} tabindex="-1" data-chips-more>+{chips.length - FOLD}</button></li>
          )}
        </ul>
      </section>
    )}

    {project.repos.length > 0 && (
      <section class={role || project.started || project.active || Content || chips.length ? "row tight rise" : "row rise"} style="--d: 60ms">
        <h2 class="lab" id="source"><a class="anchor" href="#source" aria-label={t.source + t.anchor}>{t.source}</a></h2>
        <ul class="val links">
          {project.repos.map(({ url, stats }) => (
            <li>
              <Ext href={url} hint={t.newTab} tail={tail(url)}><span dir="ltr">{head(url)}</span></Ext>
              {starsOf(stats) > 0 && <span class="mut stars" dir="ltr">★ {starsOf(stats)}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {site && (
      <section class="row tight rise" style="--d: 70ms">
        <h2 class="lab" id="site"><a class="anchor" href="#site" aria-label={t.site + t.anchor}>{t.site}</a></h2>
        <p class="val"><Ext href={project.live!} hint={t.newTab}><span dir="ltr">{site}</span></Ext></p>
      </section>
    )}

    {project.links.length > 0 && (
      <section class="row tight rise" style="--d: 72ms">
        <h2 class="lab" id="links"><a class="anchor" href="#links" aria-label={t.links + t.anchor}>{t.links}</a></h2>
        <ul class="val links">
          {project.links.map(url => <li><Ext href={url} hint={t.newTab} tail={tail(url)}><span dir="ltr">{head(url).split(/(?<=\/)/).map((part, i) => <>{i > 0 && <wbr />}{part}</>)}</span></Ext></li>)}
        </ul>
      </section>
    )}

    {Content && (
      <section class="row tight rise" style="--d: 75ms">
        <h2 class="lab" id="notes"><a class="anchor" href="#notes" aria-label={t.notes + t.anchor}>{t.notes}</a></h2>
        <div class="val prose" {...en}><Content /></div>
      </section>
    )}

    <section class={role || project.started || project.active || chips.length || project.repos.length || site || project.links.length || Content ? "row tight" : "row"}>
      <h2 class="lab" id="next"><a class="anchor" href="#next" aria-label={t.next + t.anchor}>{t.next}</a></h2>
      <p class="val">
        <a class="next" href={localized(lang, projectPath(next))}><span><span class="hl"><ProjectName owner={next.owner} name={next.name} /></span><LinkIcon kind="page" /></span></a><span class="or">{t.or}</span><a class="link" href="?list=projects" data-drawer="work">{t.allProjects(projects.length)}<LinkIcon kind="list" /></a><span class="or">{t.or}</span><a class="link" href={localized(lang)}>{t.cHome}<LinkIcon kind="page" /></a>
      </p>
    </section>
  </article>
</Base>
