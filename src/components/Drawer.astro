---
import type { Lang } from "~/i18n/langs";
import type { List } from "~/lib/lists";

import LinkIcon from "~/components/LinkIcon.astro";
import Logo from "~/components/Logo.astro";
import { ui } from "~/i18n/ui";
import { FACETS, LIST_PATHS, partsPath } from "~/lib/lists";
import { localized } from "~/lib/url";



/**
 * The list drawer: every project ("Works") or every post ("Writings"), on a sheet of
 * torn paper that slides in from the side over whatever page is showing. It has a
 * search field, a filter menu and removable chips for the filters picked. The address
 * says which list is open (?list=projects, ?list=posts), so it can be linked to.
 *
 * Only the sheet is here, with each list's search: the lists themselves, and their
 * filters, are in files beside their pages (ListPart.astro), fetched the first time one
 * is wanted (scripts/lists.ts). Each list's page is where its links lead without
 * scripts, or when its parts could not be had.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const sheets: { list: List; search: string }[] = [
  { list: "work", search: t.searchProjects },
  { list: "writing", search: t.searchPosts },
];
---

<button type="button" class="dr-scrim" tabindex="-1" aria-label={t.closeList} data-drawer-close></button>
<div
  class="dr"
  id="drawer"
  aria-labelledby="dr-title"
  data-list="work"
  data-none-q={t.noMatchQ}
  data-none-f={t.noMatchF}
  data-remove={t.removeFilter}
  data-key-sep={t.keySep}
  data-shown-of={t.shownOf}
  data-title-work={t.work}
  data-title-writing={t.writing}
  data-src-work={localized(lang, LIST_PATHS.work)}
  data-src-writing={localized(lang, LIST_PATHS.writing)}
  data-parts-work={localized(lang, partsPath("work"))}
  data-parts-writing={localized(lang, partsPath("writing"))}
>
  <span class="dr-tear" aria-hidden="true"><i></i><b></b></span>
  <div class="dr-scroll">
    <div class="dr-head">
      <span class="dr-mark"><Logo id="lg-drawer" size={44} /></span>
      <h2 class="dr-title" id="dr-title" tabindex="-1"><span data-show="work">{t.work}</span><span data-show="writing">{t.writing}</span></h2>
      <div class="dr-tabs">
        <a class="link" href={localized(lang, LIST_PATHS.writing)} data-drawer="writing" data-show="work">{t.writing}<LinkIcon kind="switch" /></a>
        <a class="link" href={localized(lang, LIST_PATHS.work)} data-drawer="work" data-show="writing">{t.work}<LinkIcon kind="switch" /></a>
        <button type="button" class="dr-x" aria-label={t.closeList} title={t.closeList} data-drawer-close>
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4l10 10M14 4L4 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        </button>
      </div>
    </div>

    {/* Each names the address parameters its filters can take, known before the filters arrive. */}
    {sheets.map(sheet => (
      <section class="dr-sheet" data-sheet={sheet.list} data-keys={FACETS[sheet.list].join(" ")} aria-busy="true">
        <div class="dr-tools">
          <div class="dr-search">
            <svg class="dr-glass" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M11 11l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
            <input type="search" class="dr-q" placeholder={sheet.search} aria-label={sheet.search} autocomplete="off" />
          </div>
          <div class="dr-active" aria-label={t.filters} hidden>
            <button type="button" class="link dr-clear" data-clear>{t.clearAll}</button>
          </div>
        </div>
        <p class="dr-empty" hidden><span></span> <button type="button" class="link" data-clear>{t.clearSearch}</button></p>
        {/* Until the list is in: a quiet word, and, if it never comes, a way to ask again. */}
        <p class="dr-wait" data-dr-wait data-failed={t.listFailed}><span>{t.listWait}</span> <button type="button" class="link" data-dr-retry hidden>{t.listRetry}</button></p>
      </section>
    ))}
    {/* Said aloud: that the list is on its way, how many it holds, how many a search or the
        filters leave. Outside the sheets, which are busy until their list is in. */}
    <p class="sr" role="status" data-dr-status></p>
  </div>
</div>
{/*
  A dialog that opens over the page, out of reach until then: made so here, as the page
  is read, by script. Without scripts it can't open, so it is none, and doesn't show:
  "All projects" and "All posts" lead to the lists' own pages instead (global.css).
*/}
<script is:inline>
  {
    const dr = document.getElementById("drawer");

    dr.inert = true;
    dr.setAttribute("role", "dialog");
    dr.setAttribute("aria-modal", "true");
  }
</script>
