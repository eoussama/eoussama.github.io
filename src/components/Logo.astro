---
/**
 * The eclipse mark, drawn from the brand logo: a disc with an off-centre hole, a
 * lavender crescent inside the hole, and a wedge pointing in.
 * `id` keeps the clip and mask ids unique when it appears twice.
 */
interface Props {
  id: string;
  size?: number;
}

const { id, size = 52 } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <clipPath id={`${id}-clip`}><circle cx="32" cy="32" r="31.81"></circle></clipPath>
  <mask id={`${id}-cut`} maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
    <rect x="0" y="0" width="64" height="64" fill="#fff"></rect>
    <ellipse class="lg-hole" cx="38.7" cy="32" rx="24.77" ry="24.05" fill="#000"></ellipse>
  </mask>
  <mask id={`${id}-moon`} maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
    <rect x="0" y="0" width="64" height="64" fill="#fff"></rect>
    <ellipse cx="34.42" cy="32" rx="20.99" ry="19.8" fill="#000"></ellipse>
  </mask>
  <g class="lg-disc"><circle cx="32" cy="32" r="31.81" fill="var(--lg-a)" mask={`url(#${id}-cut)`}></circle></g>
  <g clip-path={`url(#${id}-clip)`}>
    <g class="lg-moon"><ellipse cx="38.7" cy="32" rx="24.54" ry="23.83" fill="var(--lg-b)" mask={`url(#${id}-moon)`}></ellipse></g>
    <path class="lg-wedge" fill="var(--lg-a)" d="M-1 23.8L44.1 32L-1 40.2Z"></path>
  </g>
</svg>
