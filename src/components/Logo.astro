---
/**
 * The eclipse mark: a disc with an off-centre crescent cut out of it and a wedge
 * pointing in. `id` keeps the clip and mask ids unique when it appears twice.
 */
interface Props {
  id: string;
  size?: number;
}

const { id, size = 52 } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <clipPath id={`${id}-clip`}><circle cx="32" cy="32" r="31"></circle></clipPath>
  <mask id={`${id}-cut`} maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
    <rect x="0" y="0" width="64" height="64" fill="#fff"></rect>
    <circle class="lg-hole" cx="35.5" cy="32" r="24.5" fill="#000"></circle>
  </mask>
  <g class="lg-disc"><circle cx="32" cy="32" r="31" fill="var(--lg-ink)" mask={`url(#${id}-cut)`}></circle></g>
  <g clip-path={`url(#${id}-clip)`}>
    <path class="lg-moon" fill="var(--lg-acc)" fill-rule="evenodd" d="M12.5 32a23 23 0 1 0 46 0a23 23 0 1 0 -46 0ZM15 32a17.5 17.5 0 1 0 35 0a17.5 17.5 0 1 0 -35 0Z"></path>
  </g>
  <path class="lg-wedge" fill="var(--lg-ink)" d="M8 24.6L41 30.2a1.8 1.8 0 0 1 0 3.6L8 39.4Z"></path>
</svg>
