---
import type { Lang } from "~/i18n/langs";
import type { PageId } from "~/lib/pages";

import { render } from "astro:content";

import Ext from "~/components/Ext.astro";
import LinkIcon from "~/components/LinkIcon.astro";
import Minimap from "~/components/Minimap.astro";
import { PROFILE } from "~/data/profile";
import { ui } from "~/i18n/ui";
import Base from "~/layouts/Base.astro";
import { formatDate } from "~/lib/dates";
import { getPage, sections } from "~/lib/pages";
import { localized, url } from "~/lib/url";



/**
 * One of the site's own pages (the CV, the now page): its title and lead, then a row
 * for each of its sections, in the margin layout of a project's page.
 * The CV ends on the one-page PDF.
 */
interface Props {
  lang: Lang;
  id: PageId;
}

const { lang, id } = Astro.props;
const t = ui(lang);
const page = await getPage(id, lang);
const { label, title, lead, description, updated } = page.entry.data;
const rows = sections(page.entry.rendered?.html ?? "");
// The CV is long enough to need a map: its sections, with each post and degree under its own.
const headings = id === "cv" ? (await render(page.entry)).headings.filter(heading => heading.depth >= 2 && heading.depth <= 3) : [];
// Not yet written in this language: the English text says so, for screen readers and fonts.
const textLang = page.lang === lang ? undefined : page.lang;
const textDir = textLang ? "ltr" : undefined;
---

<Base lang={lang} path={`${id}/`} title={`${title === t.name ? label : title} · ${t.name}`} description={description} label={label}>
  <a slot="crumb" class="crumb" href={localized(lang)}>{t.name}</a>
  {headings.length >= 3 && <Minimap slot="aside" lang={lang} own={page.lang} headings={headings} />}

  <article class={`page-${id}`}>
    <section class="row first">
      <h2 class="lab" id={id}><a class="anchor" href={`#${id}`} aria-label={label + t.anchor} lang={textLang} dir={textDir}>{label}</a></h2>
      <div class="hero" lang={textLang} dir={textDir}>
        <h1><span class="title">{title}</span></h1>
        {lead && <p class="lead rise">{lead}</p>}
      </div>
    </section>

    {updated && (
      <section class="row rise" style="--d: 20ms">
        <h2 class="lab" id="updated"><a class="anchor" href="#updated" aria-label={t.lastUpdated + t.anchor}>{t.lastUpdated}</a></h2>
        <p class="val mut when"><time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated, lang)}</time></p>
      </section>
    )}

    {id === "cv" && (
      <section class="row rise contact" style="--d: 20ms">
        <h2 class="lab" id="whereabouts"><a class="anchor" href="#whereabouts" aria-label={t.where + t.anchor}>{t.where}</a></h2>
        <ul class="val cv-contact" dir={textDir}>
          <li><a class="link" href={`mailto:${PROFILE.email}`}><span dir="ltr">{PROFILE.email}</span><LinkIcon kind="mail" /></a></li>
          <li><Ext href={PROFILE.site} hint={t.newTab}><span dir="ltr">ouss.es</span></Ext></li>
          <li><Ext href={PROFILE.github.url} hint={t.newTab}><span dir="ltr">{PROFILE.github.label}</span></Ext></li>
          <li><Ext href={PROFILE.linkedin.url} hint={t.newTab}><span dir="ltr">{PROFILE.linkedin.label}</span></Ext></li>
        </ul>
      </section>
    )}

    {rows.map((row, i) => (
      <section class={i === 0 && !updated && id !== "cv" ? "row rise" : "row tight rise"} style={`--d: ${30 + i * 15}ms`}>
        {/* The label keeps the page's side of the margin; only its words are the text's language. */}
        <h2 class="lab" id={row.id}><a class="anchor" href={`#${row.id}`} aria-label={row.heading + t.anchor} lang={textLang} dir={textDir}>{row.heading}</a></h2>
        <div class="val prose" lang={textLang} dir={textDir} set:html={row.html} />
      </section>
    ))}

    {id === "cv" && (
      <section class="row tight rise" style={`--d: ${30 + rows.length * 15}ms`}>
        <h2 class="lab" id="pdf"><a class="anchor" href="#pdf" aria-label={`PDF${t.anchor}`}>PDF</a></h2>
        <p class="val"><a class="link" href={url(PROFILE.resume)} download="Oussama-Essamadi-CV.pdf">{t.resume}<LinkIcon kind="download" /></a>{t.resumeTail}</p>
      </section>
    )}
  </article>
</Base>
