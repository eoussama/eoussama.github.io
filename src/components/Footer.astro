---
import type { Lang } from "~/i18n/langs";

import Signature from "~/components/Signature.astro";
import { ui } from "~/i18n/ui";



/** The home page's sign-off, beside its last list: the signature, drawn in, and the copyright under it. */
interface Props {
  lang: Lang;
}

const t = ui(Astro.props.lang);
---

<footer class="foot">
  <Signature label={t.signature} noInk={t.noInk} />
  <p class="small">{t.copyright}</p>
</footer>
