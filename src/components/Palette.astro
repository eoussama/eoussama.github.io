---
import type { Lang } from "~/i18n/langs";

import ProjectName from "~/components/ProjectName.astro";
import { PROFILE } from "~/data/profile";
import { LANG_NAMES, LANGS } from "~/i18n/langs";
import { ui } from "~/i18n/ui";
import { formatDate } from "~/lib/dates";
import { getPosts, postPath } from "~/lib/posts";
import { getProjects, pick, projectPath } from "~/lib/projects";
import { localized, url } from "~/lib/url";
import { versions } from "~/lib/versions";



/**
 * The command menu (⌘K or Ctrl K): every page, project, language, theme, older
 * version and contact link, filtered as you type. Rendered on every page, opened by
 * the search button or the shortcut.
 */
interface Props {
  lang: Lang;
  path: string;
  /** Whether the page has the greeting, which the menu can cycle. */
  hello: boolean;
  /** Whether analytics are set up, so the menu can bring back the question. */
  consent: boolean;
}

type Item = {
  label: string;
  /** An organization shown muted before the label ("nakamaorg/"). */
  owner?: string | null;
  hint?: string;
  icon?: "z-star" | "z-cross" | "z-dia";
  href?: string;
  external?: boolean;
  action?: "theme" | "copy" | "hello" | "consent" | "keys";
  value?: string;
  lang?: Lang;
  dir?: string;
  langLink?: Lang;
  drawer?: "work" | "writing";
  keywords: string;
};

const { lang, path, hello, consent } = Astro.props;
const t = ui(lang);
const projects = await getProjects();
const posts = await getPosts(lang);

const groups: { label: string; items: Item[] }[] = [
  {
    label: t.cGo,
    items: [
      { label: t.cHome, href: localized(lang), keywords: "home" },
      { label: t.allProjectsLabel, hint: t.cList, href: "?list=projects", drawer: "work", keywords: "projects work" },
      { label: t.allPostsLabel, hint: t.cList, href: "?list=posts", drawer: "writing", keywords: "posts writing blog" },
    ],
  },
  {
    label: t.cProjects,
    items: projects.map(p => ({
      label: p.name,
      owner: p.owner,
      hint: t.kinds[p.kind],
      icon: "z-star",
      href: localized(lang, projectPath(p)),
      keywords: `${p.org ?? ""} ${pick(p.blurb, lang)} ${p.languages.join(" ")} ${p.tools.join(" ")} ${p.tags.join(" ")} ${p.type} ${p.kind} ${p.year ?? ""}`,
    })),
  },
  {
    label: t.cPosts,
    items: posts.map(post => ({
      label: post.entry.data.title,
      lang: post.lang === lang ? undefined : post.lang,
      hint: formatDate(post.entry.data.date, lang),
      icon: "z-cross",
      href: localized(lang, postPath(post)),
      keywords: `${post.entry.data.summary} ${post.entry.data.tags.join(" ")}`,
    })),
  },
  {
    label: t.cLang,
    items: LANGS.map(l => ({
      label: l.name,
      hint: l.code === lang ? t.cCurrent : "",
      lang: l.code,
      dir: l.dir,
      langLink: l.code,
      href: localized(l.code, path),
      keywords: `language translate ${l.code} ${LANG_NAMES[l.code]}`,
    })),
  },
  {
    label: t.cTheme,
    items: (["light", "dark", "auto"] as const).map(key => ({
      label: t[key],
      action: "theme",
      value: key,
      keywords: `theme appearance mode ${key}`,
    })),
  },
  {
    label: t.cVers,
    items: versions(lang).map(v => ({ label: `${v.name}, ${v.title}`, hint: String(v.year), href: v.href, keywords: "version archive old" })),
  },
  {
    label: t.cWhere,
    items: [
      { label: t.cGh, hint: "↗", href: PROFILE.github.url, external: true, keywords: "code eoussama github" },
      { label: t.cLi, hint: "↗", href: PROFILE.linkedin.url, external: true, keywords: "work history eoussama linkedin" },
      { label: t.cCv, hint: "PDF ↗", href: url(PROFILE.resume), external: true, keywords: "resume cv pdf" },
      { label: t.cMail, action: "copy", keywords: "contact write mail email" },
      { label: t.cSponsor, hint: "↗", href: PROFILE.sponsors, external: true, keywords: "support sponsor donate github sponsors" },
      { label: t.cTip, hint: "↗", href: PROFILE.paypal, external: true, keywords: "support tip donate paypal coffee" },
    ],
  },
];

const extras: Item[] = [{ label: t.keysTitle, hint: "?", action: "keys", keywords: "keyboard shortcuts keys help" }];

if (hello) {
  extras.push({ label: t.cHi, action: "hello", keywords: "greeting hello hi" });
}

if (consent) {
  extras.push({ label: t.cConsent, action: "consent", keywords: "analytics cookies privacy consent" });
}

if (extras.length) {
  groups.push({ label: t.cExtras, items: extras });
}

let n = 0;
---

<dialog class="ck" id="palette" aria-label={t.palTitle} data-none={t.palNone} data-current={t.cCurrent}>
  <div class="ck-note">
    <div class="ck-sheet">
      <span class="note-shadow" aria-hidden="true"></span>
      <div class="ck-box">
        <div class="ck-top">
          <svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M11 11l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
          <input type="text" class="ck-q" role="combobox" aria-expanded="true" aria-controls="ck-list" aria-autocomplete="list" aria-label={t.palPh} placeholder={t.palPh} autocomplete="off" spellcheck="false" />
          <button type="button" class="ck-esc" aria-label={t.palClose} data-palette-close><kbd class="ck-kbd" dir="ltr">esc</kbd></button>
        </div>
        <div class="ck-list" id="ck-list" role="listbox" aria-label={t.palTitle}>
          {groups.map((group, g) => (
            <div class="ck-group" role="group" aria-labelledby={`ck-g${g}`}>
              <p class="ck-h" id={`ck-g${g}`}>{group.label}</p>
              {group.items.map((item) => {
                const id = `ck-${n++}`;
                const keywords = `${group.label} ${item.owner ?? ""} ${item.label} ${item.hint ?? ""} ${item.keywords}`.toLowerCase();
                const inner = (
                  <Fragment>
                    <i class:list={["ck-ic", item.icon ?? "z-dia"]}></i>
                    <span class="ck-l"><span lang={item.lang} dir={item.dir}>{item.owner === undefined ? item.label : <ProjectName owner={item.owner} name={item.label} />}</span></span>
                    <span class="ck-hint" data-theme-hint={item.action === "theme" ? item.value : undefined}>{item.hint}</span>
                  </Fragment>
                );

                return item.href
                  ? <a class="ck-item" id={id} role="option" aria-selected="false" tabindex="-1" href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined} hreflang={item.langLink} data-lang-link={item.langLink} data-drawer={item.drawer} data-kw={keywords}>{inner}</a>
                  : <button type="button" class="ck-item" id={id} role="option" aria-selected="false" tabindex="-1" data-action={item.action} data-value={item.value} data-kw={keywords}>{inner}</button>;
              })}
            </div>
          ))}
          <p class="ck-empty" hidden></p>
        </div>
        <p class="ck-foot"><span><kbd class="ck-kbd">↑</kbd><kbd class="ck-kbd">↓</kbd> {t.move}</span><span><kbd class="ck-kbd">↵</kbd> {t.run}</span><span><kbd class="ck-kbd">esc</kbd> {t.close}</span></p>
      </div>
      <span class="note-tear" aria-hidden="true"><i></i></span>
    </div>
  </div>
</dialog>
