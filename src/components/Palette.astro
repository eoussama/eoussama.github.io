---
import type { Lang } from "~/i18n/langs";

import type { List } from "~/lib/lists";

import ProjectName from "~/components/ProjectName.astro";
import { PROFILE } from "~/data/profile";
import { LANG_NAMES, LANGS } from "~/i18n/langs";
import { ui } from "~/i18n/ui";
import { LIST_PATHS } from "~/lib/lists";
import { getPage, PAGES } from "~/lib/pages";
import { getShortLinks } from "~/lib/short-links";
import { localized, url } from "~/lib/url";
import { versions } from "~/lib/versions";



/**
 * The command menu (⌘K or Ctrl K): every page, project, language, theme, older
 * version and contact link, filtered as you type. Rendered on every page, opened by
 * the search button or the shortcut. The projects and posts come from the lists' items,
 * in files beside their pages, fetched as the menu is about to open (scripts/lists.ts)
 * and put in their groups, which wait here empty.
 */
interface Props {
  lang: Lang;
  path: string;
  /** Whether the page has the greeting, which the menu can cycle. */
  hello: boolean;
  /** Whether analytics are set up, so the menu can bring back the question. */
  consent: boolean;
}

type Item = {
  label: string;
  /** An organization shown muted before the label ("nakamaorg/"). */
  owner?: string | null;
  hint?: string;
  icon?: "z-star" | "z-cross" | "z-dia";
  href?: string;
  external?: boolean;
  /** The file name to save it under: a link to a file to download, not to open. */
  download?: string;
  action?: "theme" | "copy" | "hello" | "consent" | "keys" | "shortcuts";
  /** The single key that does the same, shown when the item is pointed at or selected. */
  key?: string;
  /** Whether it is the one in use now (the page's language), shown as a check mark. */
  current?: boolean;
  /** An icon after the label, for what the item does besides opening something. */
  tail?: "copy" | "download" | "out";
  value?: string;
  lang?: Lang;
  dir?: string;
  langLink?: Lang;
  drawer?: "work" | "writing";
  keywords: string;
};

const { lang, path, hello, consent } = Astro.props;
const t = ui(lang);
const links = await getShortLinks();
const pages = await Promise.all(PAGES.map(async id => ({ id, data: (await getPage(id, lang)).entry.data })));

const groups: { label: string; items: Item[]; list?: List }[] = [
  {
    label: t.cGo,
    items: [
      { label: t.cHome, href: localized(lang), key: "H", keywords: "home" },
      { label: t.allWorksLabel, href: localized(lang, LIST_PATHS.work), drawer: "work", key: "P", keywords: "projects work list" },
      { label: t.allWritingsLabel, href: localized(lang, LIST_PATHS.writing), drawer: "writing", key: "W", keywords: "posts writing blog list" },
      ...pages.map(({ id, data }) => ({ label: data.label, href: localized(lang, `${id}/`), keywords: `${id} ${data.title} ${data.description}` })),
    ],
  },
  // Filled in once the lists are here (scripts/palette.ts).
  { label: t.cProjects, items: [], list: "work" },
  { label: t.cPosts, items: [], list: "writing" },
  {
    label: t.cLang,
    items: LANGS.map(l => ({
      label: l.name,
      current: l.code === lang,
      lang: l.code,
      dir: l.dir,
      langLink: l.code,
      href: localized(l.code, path),
      keywords: `language translate ${l.code} ${LANG_NAMES[l.code]}`,
    })),
  },
  {
    label: t.cTheme,
    items: (["light", "dark", "auto"] as const).map(key => ({
      label: t[key],
      action: "theme",
      value: key,
      keywords: `theme appearance mode ${key}`,
    })),
  },
  {
    label: t.cVers,
    items: versions(lang).map(v => ({ label: `${v.name}, ${v.title}`, hint: String(v.year), href: v.href, keywords: "version archive old" })),
  },
  {
    label: t.cWhere,
    items: [
      { label: t.cGh, tail: "out", href: PROFILE.github, external: true, keywords: "code eoussama github" },
      { label: t.cLi, tail: "out", href: PROFILE.linkedin, external: true, keywords: "work history eoussama linkedin" },
      { label: t.cCv, tail: "download", href: url(PROFILE.resume), download: "Oussama-Essamadi-CV.pdf", keywords: "resume cv pdf download" },
      { label: t.cMail, action: "copy", tail: "copy", keywords: "contact write mail email" },
      { label: t.cSponsor, tail: "out", href: PROFILE.sponsors, external: true, keywords: "support sponsor donate github sponsors" },
      { label: t.cTip, tail: "out", href: PROFILE.paypal, external: true, keywords: "support tip donate paypal coffee" },
    ],
  },
];

// The single-key shortcuts can be turned off, for whoever they get in the way of (speech
// input, say): the label says what choosing it does, and the menu sets it as it opens.
const extras: Item[] = [
  { label: t.keysTitle, action: "keys", key: "?", keywords: "keyboard shortcuts keys help" },
  { label: t.keysOff, action: "shortcuts", keywords: `keyboard shortcuts keys turn off on disable enable ${t.keysOn}` },
];

if (hello) {
  extras.push({ label: t.cHi, action: "hello", keywords: "greeting hello hi" });
}

if (consent) {
  extras.push({ label: t.cConsent, action: "consent", keywords: "analytics cookies privacy consent" });
}

if (extras.length) {
  groups.push({ label: t.cExtras, items: extras });
}

let n = 0;
---

<dialog class="ck" id="palette" aria-label={t.palTitle} data-none={t.palNone} data-wait={t.palWait} data-failed={t.palFailed}>
  <div class="ck-note">
    <div class="ck-sheet">
      <span class="note-shadow" aria-hidden="true"></span>
      <div class="ck-box">
        <div class="ck-top">
          <svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M11 11l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
          <input type="text" class="ck-q" role="combobox" aria-expanded="true" aria-controls="ck-list" aria-autocomplete="list" aria-label={t.palPh} placeholder={t.palPh} data-short={t.palPhShort} autocomplete="off" spellcheck="false" />
          <button type="button" class="ck-esc" aria-label={t.palClose} data-palette-close><kbd class="ck-kbd" dir="ltr">esc</kbd></button>
        </div>
        {/* Not a stop of its own for Tab, though it scrolls: the arrow keys move through it from the search. */}
        <div class="ck-list" id="ck-list" role="listbox" aria-label={t.palTitle} tabindex="-1">
          {groups.map((group, g) => (
            <div class="ck-group" role="group" aria-labelledby={`ck-g${g}`} data-ck-list={group.list} hidden={!group.items.length}>
              <p class="ck-h" id={`ck-g${g}`}>{group.label}</p>
              {group.items.map((item) => {
                const id = `ck-${n++}`;
                const keywords = `${group.label} ${item.owner ?? ""} ${item.label} ${item.hint ?? ""} ${item.keywords}`.toLowerCase();
                const inner = (
                  <Fragment>
                    <i class:list={["ck-ic", item.icon ?? "z-dia"]}></i>
                    <span class="ck-l"><span lang={item.lang} dir={item.dir}>{item.owner === undefined ? item.label : <ProjectName owner={item.owner} name={item.label} />}</span></span>
                    <span class="ck-hint">{item.hint}</span>
                    {/* A check mark for what is in use: the language of the page, and the theme (set as the menu opens, scripts/palette.ts). */}
                    {(item.current !== undefined || item.action === "theme") && <span class="ck-check" data-on={item.current ? "" : undefined} data-theme-check={item.action === "theme" ? item.value : undefined}><svg class="ck-tail" width="13" height="13" viewBox="0 0 11 11" aria-hidden="true"><path d="M1.8 5.9l2.5 2.4L9.2 2.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="sr">{t.cCurrent}</span></span>}
                    {/* What the item does besides opening something, as one icon size: copy, download, or out to another site. */}
                    {item.tail === "copy" && <svg class="ck-tail" width="13" height="13" viewBox="0 0 11 11" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><rect x="1.2" y="3.6" width="6.2" height="6.2" rx="1.1"></rect><path d="M3.6 3.6V2.3a1.1 1.1 0 0 1 1.1-1.1h4a1.1 1.1 0 0 1 1.1 1.1v4a1.1 1.1 0 0 1-1.1 1.1H7.4"></path></g></svg>}
                    {item.tail === "download" && <svg class="ck-tail" width="13" height="13" viewBox="0 0 11 11" aria-hidden="true"><path d="M5.5 1.6v5.4M3.1 4.7l2.4 2.4 2.4-2.4M2 9.4h7" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>}
                    {item.tail === "out" && <svg class="ck-tail ck-out" width="13" height="13" viewBox="0 0 11 11" aria-hidden="true"><path d="M2.5 8.5l6-6M3.5 2.5h5v5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>}
                    {/* Said, as the site's other links out say it (Ext.astro); the search reads data-kw, not this. */}
                    {item.external && <span class="sr">{t.newTab}</span>}
                    {item.key && <kbd class="ck-kbd ck-key" dir="ltr" aria-hidden="true">{item.key}</kbd>}
                  </Fragment>
                );

                return item.href
                  ? <a class="ck-item" id={id} role="option" aria-selected="false" tabindex="-1" href={item.external ? links.href(item.href) : item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined} download={item.download} hreflang={item.langLink} data-lang-link={item.langLink} data-drawer={item.drawer} aria-keyshortcuts={item.key} data-keyshortcut={item.key} data-kw={keywords}>{inner}</a>
                  : <button type="button" class="ck-item" id={id} role="option" aria-selected="false" tabindex="-1" data-action={item.action} data-value={item.value} aria-keyshortcuts={item.key} data-keyshortcut={item.key} data-kw={keywords} data-off={item.action === "shortcuts" ? t.keysOff : undefined} data-on={item.action === "shortcuts" ? t.keysOn : undefined}>{inner}</button>;
              })}
            </div>
          ))}
        </div>
        {/* Outside the list, which holds only options, and read out as it changes: so it is
            always there, and empty while something matches (scripts/palette.ts). */}
        <p class="ck-empty" role="status"></p>
        <p class="ck-foot"><span><kbd class="ck-kbd">↑</kbd><kbd class="ck-kbd">↓</kbd> {t.move}</span><span><kbd class="ck-kbd">↵</kbd> {t.run}</span><span><kbd class="ck-kbd">esc</kbd> {t.close}</span></p>
      </div>
      <span class="note-tear" aria-hidden="true"><i></i></span>
    </div>
  </div>
</dialog>
