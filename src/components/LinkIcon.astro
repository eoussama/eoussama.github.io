---
/**
 * The small icon at the end of a link within the site, shown on hover like the copy
 * icon: a drawer for the links that open a list, a chevron for those that open a page,
 * two arrows for the drawer's switch to the other list, an at sign for an email.
 */
interface Props {
  kind: "list" | "page" | "switch" | "mail";
}

const { kind } = Astro.props;
---

{kind === "switch" && (
  <svg class="lk-ic lk-switch" width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><path d="M1.6 3.6h7.4M7.2 1.6l2 2-2 2M9.4 7.4H2M3.8 5.4l-2 2 2 2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
)}
{kind === "mail" && (
  <svg class="lk-ic lk-mail" width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><circle cx="5.5" cy="5.5" r="1.9"></circle><path d="M7.4 3.8v2.3a1.25 1.25 0 0 0 2.5 0v-.6a4.4 4.4 0 1 0-1.75 3.5"></path></g></svg>
)}
{kind === "list" && (
  <svg class="lk-ic lk-list" width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><rect x="1" y="1.6" width="9" height="7.8" rx="1.3"></rect><path d="M6.4 1.6v7.8M7.9 4h.9M7.9 5.8h.9"></path></g></svg>
)}
{kind === "page" && (
  <svg class="lk-ic lk-page" width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><path d="M4 2.3l3.2 3.2L4 8.7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
)}
