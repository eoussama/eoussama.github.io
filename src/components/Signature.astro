---
/**
 * Oussama's signature, traced from his own hand and written in one motion. Each piece
 * of the stroke is revealed by a mask path that draws in, in the order and at the pace
 * it was written, and fresh ink glosses dark for a moment where the nib has just passed.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
