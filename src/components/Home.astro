---
import type { Lang } from "~/i18n/langs";

import Ext from "~/components/Ext.astro";
import Footer from "~/components/Footer.astro";
import LinkIcon from "~/components/LinkIcon.astro";
import ProjectName from "~/components/ProjectName.astro";
import { PROFILE } from "~/data/profile";
import { HELLO_ORDER, langInfo } from "~/i18n/langs";
import { ui } from "~/i18n/ui";
import Base from "~/layouts/Base.astro";
import { formatDate } from "~/lib/dates";
import { getPosts, postPath } from "~/lib/posts";
import { getProjects, pick, projectPath } from "~/lib/projects";
import { localized, url } from "~/lib/url";



/** The home page, in one language. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);

// The greeting starts in the page's language and cycles through the rest.
const start = HELLO_ORDER.indexOf(lang);
const hellos = [...HELLO_ORDER.slice(start), ...HELLO_ORDER.slice(0, start)].map((code) => {
  const info = langInfo(code);

  return { text: info.hello, lang: code, dir: info.dir };
});
const first = hellos[0]!;

/*
 * The intro, word by word, each in a box of its own. The words glide when the greeting
 * beside them changes size, and are boxed from the start so the lines never re-wrap:
 * boxes break a hair differently from plain text. Japanese, without spaces, is cut
 * into its words.
 */
const introWords = /\s/.test(t.intro.trim())
  ? t.intro.split(/(\s+)/).filter(Boolean)
  : Array.from(new Intl.Segmenter(lang, { granularity: "word" }).segment(t.intro), part => part.segment);

const projects = await getProjects();
const featured = projects.filter(p => p.featured).slice(0, 4);

const posts = await getPosts(lang);
---

<Base lang={lang} title={t.name} description={`${t.name}.${t.intro}`} hello>
  <section class="row first" aria-labelledby="whoami">
    <h2 class="lab hello-lab" id="whoami"><a class="anchor" href="#whoami" aria-label={t.whoami + t.anchor}>{t.whoami}</a></h2>
    <div>
      <h1><span class="site-name">{t.name}</span></h1>
      <p class="intro"><button type="button" class="link hello" lang={first.lang} dir={first.dir} aria-label={`${first.text} ${t.hiAria}`} data-hint={t.hiAria} data-hellos={JSON.stringify(hellos)}>{first.text}</button>{introWords.map(part => /^\s+$/.test(part) ? part : <span class="iw">{part}</span>)}</p>
    </div>
  </section>

  <div class="home">
    <section class="row" aria-labelledby="work">
      <h2 class="lab" id="work"><a class="anchor" href="#work" aria-label={t.work + t.anchor}>{t.work}</a></h2>
      <ul class="list">
        {featured.map(project => (
          <li>
            <i class="dot z-star"></i><a class="link" href={localized(lang, projectPath(project))}><ProjectName owner={project.owner} name={project.name} /><LinkIcon kind="page" /></a>{t.sep}{pick(project.desc ?? project.blurb, lang)}
            {project.note && <p class="note">{pick(project.note, lang)}</p>}
          </li>
        ))}
        <li><i class="dot z-star"></i><a class="link" href="?list=projects" data-drawer="work">{t.allProjects(projects.length)}<LinkIcon kind="list" /></a></li>
      </ul>
    </section>

    <section class="row" aria-labelledby="writing">
      <h2 class="lab" id="writing"><a class="anchor" href="#writing" aria-label={t.writing + t.anchor}>{t.writing}</a></h2>
      <ul class="list">
        {posts.slice(0, 2).map(post => (
          <li>
            <i class="dot z-cross"></i><a class="link" href={localized(lang, postPath(post))} lang={post.lang}><span dir={langInfo(post.lang).dir}>{post.entry.data.title}</span><LinkIcon kind="page" /></a> <span class="mut when">{formatDate(post.entry.data.date, lang)}</span>
            {post.entry.data.note && <p class="note" lang={post.lang} dir={langInfo(post.lang).dir}>{post.entry.data.note}</p>}
          </li>
        ))}
        <li><i class="dot z-cross"></i><a class="link" href="?list=posts" data-drawer="writing">{t.allPosts(posts.length)}<LinkIcon kind="list" /></a></li>
      </ul>
    </section>

    <section class="row" aria-labelledby="whereabouts">
      <h2 class="lab" id="whereabouts"><a class="anchor" href="#whereabouts" aria-label={t.where + t.anchor}>{t.where}</a></h2>
      <div class="where">
        <ul class="list">
          <li><i class="dot z-dia"></i><Ext href={PROFILE.github.url} hint={t.newTab}><span dir="ltr">{PROFILE.github.label}</span></Ext>{t.codeTail}</li>
          <li><i class="dot z-dia"></i><Ext href={PROFILE.linkedin.url} hint={t.newTab}><span dir="ltr">{PROFILE.linkedin.label}</span></Ext>{t.workTail}</li>
          <li><i class="dot z-dia"></i><Ext href={url(PROFILE.resume)} hint={t.newTab}>{t.resume}</Ext>{t.resumeTail}</li>
          <li><i class="dot z-dia"></i><button type="button" class="link copy" data-copy={PROFILE.email} data-copied={t.copied} data-copied-long={t.copiedLong}><span class="cp-win" data-copy-label><span class="cp-t">{t.copyEmail}</span></span><svg class="copy-ic" width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><g class="ic-copy" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><rect x="1.2" y="3.6" width="6.2" height="6.2" rx="1.1"></rect><path d="M3.6 3.6V2.3a1.1 1.1 0 0 1 1.1-1.1h4a1.1 1.1 0 0 1 1.1 1.1v4a1.1 1.1 0 0 1-1.1 1.1H7.4"></path></g><path class="ic-check" d="M1.8 5.9l2.5 2.4L9.2 2.8" pathLength="1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>{t.emailOr}<a class="link" href={`mailto:${PROFILE.email}`}>{t.writeMe}<LinkIcon kind="mail" /></a>{t.emailEnd}<span class="sr" aria-live="polite" data-copy-status></span></li>
        </ul>
        <Footer lang={lang} />
      </div>
    </section>
  </div>

</Base>
