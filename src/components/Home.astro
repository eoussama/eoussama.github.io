---
import type { Lang } from "~/i18n/langs";

import Ext from "~/components/Ext.astro";
import Footer from "~/components/Footer.astro";
import Glue from "~/components/Glue.astro";
import LinkIcon from "~/components/LinkIcon.astro";
import ProjectName from "~/components/ProjectName.astro";
import { PROFILE } from "~/data/profile";
import { DAY, EID } from "~/i18n/greetings";
import { HELLO_ORDER, langInfo } from "~/i18n/langs";
import { ui } from "~/i18n/ui";
import Base from "~/layouts/Base.astro";
import { formatDate } from "~/lib/dates";
import { describe } from "~/lib/describe";
import { LIST_PATHS } from "~/lib/lists";
import { getPosts, postPath } from "~/lib/posts";
import { getProjects, pick, projectPath } from "~/lib/projects";
import { homeSchema } from "~/lib/schema";
import { getShortLinks } from "~/lib/short-links";
import { localized, url } from "~/lib/url";



/** The home page, in one language. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const links = await getShortLinks();

// The greeting starts in the page's language and cycles through the rest.
const start = HELLO_ORDER.indexOf(lang);
const hellos = [...HELLO_ORDER.slice(start), ...HELLO_ORDER.slice(0, start)].map((code) => {
  const info = langInfo(code);

  return { text: info.hello, lang: code, dir: info.dir };
});
const first = hellos[0]!;

/*
 * The intro, word by word, each in a box of its own. The words glide when the greeting
 * beside them changes size, and are boxed from the start so the lines never re-wrap:
 * boxes break a hair differently from plain text. Japanese, without spaces, is cut
 * into its words, each keeping the punctuation that closes it and the bracket that
 * opens it: a box of its own, a comma or a full stop could start a line.
 */
const CLOSING = /^[、。，．！？）」』】・,.!?:;)،؛؟]+$/u;
const OPENING = /^[（「『【(]+$/u;
const introWords = /\s/.test(t.intro.trim())
  ? t.intro.split(/(\s+)/).filter(Boolean)
  : Array.from(new Intl.Segmenter(lang, { granularity: "word" }).segment(t.intro), part => part.segment).reduce<string[]>((words, part) => {
      const k = words.length - 1;

      if (k >= 0 && (CLOSING.test(part) || OPENING.test(words[k]!))) {
        words[k] += part;
      }
      else {
        words.push(part);
      }

      return words;
    }, []);

const projects = await getProjects();
const featured = projects.filter(p => p.featured).slice(0, 4);

const posts = await getPosts(lang);
---

<Base lang={lang} title={`${t.name} · ${t.job}`} label={t.name} description={describe(t.intro.trim())} schema={homeSchema(lang)} hello>
  {/* The name beside the logo, where every other page has its way home. Not a .crumb:
      the trail (Base.astro) renames that after the page before. Hidden from screen
      readers, which have the page's heading, in its main content, instead. */}
  <p slot="crumb" class="bar-name" aria-hidden="true"><span class="site-name">{t.name}</span></p>
  <section class="row first" aria-label={t.whoami}>
    <h2 class="lab" id="whoami"><a class="anchor" href="#whoami" aria-label={t.whoami + t.anchor}>{t.whoami}</a></h2>
    <div>
      <h1 class="sr">{t.name}</h1>
      <p class="intro"><button type="button" class="link hello" lang={first.lang} dir={first.dir} aria-label={`${first.text} ${t.hiAria}`} data-hint={t.hiAria} data-hellos={JSON.stringify(hellos)}>{first.text}</button><span class="hello hello-print" lang={first.lang} dir={first.dir} aria-hidden="true">{first.text}</span><noscript><span class="hello" lang={first.lang} dir={first.dir}>{first.text}</span></noscript>{introWords.map(part => /^\s+$/.test(part) ? part : <span class="iw">{part}</span>)}</p>
      {/*
        The page opens on the day's greeting: Eid's on the days of Eid (the first three of
        Shawwal, the four from the tenth of Dhu al-Hijjah, by the browser's Umm al-Qura
        calendar), otherwise the visitor's time of day's (morning from five, afternoon
        from noon, evening from six). Set as the page is read, before it is first drawn,
        so the intro never rewraps around a greeting that changed under it.
        scripts/site.ts takes it from there.
      */}
      <script is:inline data-vars={JSON.stringify({ eid: EID[lang], day: DAY[lang], hint: t.hiAria })}>
        (() => {
          const { eid, day, hint } = JSON.parse(document.currentScript.dataset.vars);
          const hello = document.querySelector("[data-hellos]");
          let eidToday = false;

          try {
            const parts = new Intl.DateTimeFormat("en-u-ca-islamic-umalqura", { month: "numeric", day: "numeric" }).formatToParts(new Date());
            const month = Number(parts.find(part => part.type === "month")?.value);
            const date = Number(parts.find(part => part.type === "day")?.value);

            eidToday = (month === 10 && date <= 3) || (month === 12 && date >= 10 && date <= 13);
          }
          catch {}

          const hour = new Date().getHours();
          const special = eidToday ? eid : day[hour >= 5 && hour < 12 ? 0 : hour >= 12 && hour < 18 ? 1 : 2];

          if (hello && special) {
            hello.textContent = special;
            hello.setAttribute("aria-label", `${special} ${hint}`);
            hello.dataset.opening = special;

            // One too wide to drop beside the text is set a size down to fit, on one line,
            // as fit() in site.ts does again once the fonts are in.
            const room = hello.parentElement.clientWidth * (matchMedia("(min-width: 701px)").matches ? 0.62 : 1);

            hello.style.whiteSpace = "nowrap";

            const width = hello.getBoundingClientRect().width;
            const size = Number.parseFloat(getComputedStyle(hello).fontSize);

            hello.style.whiteSpace = "";

            if (width > room) {
              hello.style.setProperty("--drop", `${(size * room / width).toFixed(1)}px`);
              hello.dataset.fit = "";
            }
          }
        })();
      </script>
    </div>
  </section>

  <div class="home">
    <section class="row" id="works" aria-label={t.work}>
      <h2 class="lab" id="work"><a class="anchor" href="#work" aria-label={t.work + t.anchor}>{t.work}</a></h2>
      <ul class="list">
        {featured.map(project => (
          <li>
            <i class="dot z-star"></i><a class="link" href={localized(lang, projectPath(project))}><ProjectName owner={project.owner} name={project.name} /><LinkIcon kind="page" /></a>{t.sep}{pick(project.desc ?? project.blurb, lang)}
            {project.note && <p class="note">{pick(project.note, lang)}</p>}
          </li>
        ))}
        <li><i class="dot z-star"></i><a class="link" href={localized(lang, LIST_PATHS.work)} data-drawer="work" data-carry="work">{t.allWorks(projects.length)}<LinkIcon kind="list" /></a></li>
      </ul>
    </section>

    <section class="row" id="writings" aria-label={t.writing}>
      <h2 class="lab" id="writing"><a class="anchor" href="#writing" aria-label={t.writing + t.anchor}>{t.writing}</a></h2>
      <ul class="list">
        {posts.slice(0, 2).map(post => (
          <li>
            <i class="dot z-cross"></i><a class="link" href={localized(lang, postPath(post))} lang={post.lang}><span dir={langInfo(post.lang).dir}>{post.entry.data.title}</span><LinkIcon kind="page" /></a> <span class="mut when">{formatDate(post.entry.data.date, lang)}</span>
            {/* The note sits in the page's margin, set out in the page's direction; only its words are the post's. */}
            {post.entry.data.note && <p class="note"><span lang={post.lang} dir={langInfo(post.lang).dir}>{post.entry.data.note}</span></p>}
          </li>
        ))}
        <li><i class="dot z-cross"></i><a class="link" href={localized(lang, LIST_PATHS.writing)} data-drawer="writing" data-carry="writing">{t.allWritings(posts.length)}<LinkIcon kind="list" /></a></li>
      </ul>
    </section>

    <section class="row" aria-label={t.where}>
      <h2 class="lab" id="whereabouts"><a class="anchor" href="#whereabouts" aria-label={t.where + t.anchor}>{t.where}</a></h2>
      <div class="where">
        <ul class="list">
          <li><i class="dot z-dia"></i><Glue after={t.codeTail}><Ext href={PROFILE.github} hint={t.newTab}><span dir="ltr">{links.text(PROFILE.github)}</span></Ext></Glue></li>
          <li><i class="dot z-dia"></i><Glue after={t.workTail}><Ext href={PROFILE.linkedin} hint={t.newTab}><span dir="ltr">{links.text(PROFILE.linkedin)}</span></Ext></Glue></li>
          <li><i class="dot z-dia"></i><Glue after={t.designSep}><Ext href={PROFILE.behance} hint={t.newTab}>Behance</Ext></Glue><Glue after={t.designAnd}><Ext href={PROFILE.dribbble} hint={t.newTab}>Dribbble</Ext></Glue><Glue after={t.designTail}><Ext href={PROFILE.figma} hint={t.newTab}>Figma</Ext></Glue></li>
          <li><i class="dot z-dia"></i>{t.cvPre}<Glue after={t.cvOr}><a class="link" href={localized(lang, "cv/")}>{t.cvLink}<LinkIcon kind="page" /></a></Glue><Glue after={t.cvAnd}><a class="link" href={url(PROFILE.resume)} download="Oussama-Essamadi-CV.pdf">{t.cvPdf}<LinkIcon kind="download" /></a></Glue><Glue after={t.cvEnd}><a class="link" href={localized(lang, "now/")}>{t.nowLink}<LinkIcon kind="page" /></a></Glue></li>
          <li><i class="dot z-dia"></i><span class="em-screen"><Glue after={t.emailOr}><button type="button" class="link copy" data-copy={PROFILE.email} data-copied={t.copied} data-copied-long={t.copiedLong}><span class="cp-win" data-copy-label><span class="cp-t">{t.copyEmail}</span></span><svg class="copy-ic" width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><g class="ic-copy" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><rect x="1.2" y="3.6" width="6.2" height="6.2" rx="1.1"></rect><path d="M3.6 3.6V2.3a1.1 1.1 0 0 1 1.1-1.1h4a1.1 1.1 0 0 1 1.1 1.1v4a1.1 1.1 0 0 1-1.1 1.1H7.4"></path></g><path class="ic-check" d="M1.8 5.9l2.5 2.4L9.2 2.8" pathLength="1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></Glue><Glue after={t.emailEnd}><a class="link" href={links.href(`mailto:${PROFILE.email}`)} data-email>{t.writeMe}<LinkIcon kind="mail" /></a></Glue></span><span class="em-print">{t.mailAt}<Glue after={t.mailAtEnd}><a class="link" href={links.href(`mailto:${PROFILE.email}`)} data-email><span dir="ltr">{PROFILE.email}</span><LinkIcon kind="mail" /></a></Glue></span><span class="sr" aria-live="polite" data-copy-status></span></li>
          <li><i class="dot z-dia"></i><Glue after={t.supportOr}><Ext href={PROFILE.sponsors} hint={t.newTab}>{t.sponsor}</Ext></Glue><Glue after={t.supportEnd}><Ext href={PROFILE.paypal} hint={t.newTab}>{t.tip}</Ext></Glue></li>
        </ul>
        <Footer lang={lang} />
      </div>
    </section>
  </div>

  {/*
    On a screen wider than a phone the page keeps to one screenful: its type steps down
    a size at a few heights, and its spacing follows the height in between (global.css).
    How much text there is changes with the language, the greeting and the width, so
    where the page still runs a little past the bottom, its spacing is taken in by that
    much (--fit, a share of it), and no more. Where taking in all but the last of it
    still wouldn't do, it is left as it is, to scroll. Measured again whenever the page
    or the window changes size: fonts arriving, the greeting holding a taller intro,
    room made for the consent note.
  */}
  <script is:inline>
    (() => {
      const col = document.querySelector(".col");
      const page = document.querySelector(".page");
      const wide = matchMedia("(min-width: 701px)");
      // Below this share of its spacing the page reads cramped: it scrolls instead.
      const least = 0.4;

      if (!col || !page) {
        return;
      }

      // How far the page runs past the bottom of the window (less than 0 when it ends above).
      const over = () => page.getBoundingClientRect().bottom + scrollY - innerHeight;

      const fit = () => {
        col.style.removeProperty("--fit");

        if (!wide.matches) {
          return;
        }

        const full = over();

        if (full <= 0) {
          return;
        }

        // The spacing scales as one, so the room it takes is measured with none of it.
        col.style.setProperty("--fit", "0");

        const room = full - over();
        // A pixel to spare, for the rounding of what it lays out.
        const share = room > 0 ? 1 - (full + 1) / room : 0;

        if (share >= least) {
          col.style.setProperty("--fit", share.toFixed(3));
        }
        else {
          col.style.removeProperty("--fit");
        }
      };

      let frame = 0;
      const later = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(fit);
      };

      fit();
      addEventListener("resize", later, { passive: true });
      // A size this sets settles at once: measured again, it comes out the same.
      new ResizeObserver(later).observe(page);
    })();
  </script>

</Base>
