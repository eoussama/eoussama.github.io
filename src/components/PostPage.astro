---
import type { Lang } from "~/i18n/langs";

import { render } from "astro:content";

import LinkIcon from "~/components/LinkIcon.astro";
import Minimap from "~/components/Minimap.astro";
import { langInfo } from "~/i18n/langs";
import { ui } from "~/i18n/ui";
import Base from "~/layouts/Base.astro";
import { formatDate } from "~/lib/dates";
import { getPosts, postPath } from "~/lib/posts";
import { localized } from "~/lib/url";



/**
 * A post's own page: its title and its first sentence, then when it was published,
 * the post itself and the next post. Arriving from a list, the post's name grows
 * into the title.
 */
interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = ui(lang);
const posts = await getPosts(lang);
const index = posts.findIndex(p => p.slug === slug);
const post = posts[index]!;
const next = posts.length > 1 ? posts[(index + 1) % posts.length]! : null;
const { Content, headings } = await render(post.entry);
// The map shows the post's sections and their parts, when there are enough to need one.
const outline = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4);
const { title, summary, date } = post.entry.data;

// A post not written in this language shows in English, marked as such.
const own = { lang: post.lang, dir: langInfo(post.lang).dir };
---

<Base lang={lang} path={postPath(post)} title={`${title} · ${t.name}`} description={summary} kind="article">
  <a slot="crumb" class="crumb" href={localized(lang)}>{t.name}</a>
  {outline.length >= 3 && <Minimap slot="aside" lang={lang} own={post.lang} headings={outline} />}

  <article class="post" style={`--vt-name: vt-name-blog-${slug}`}>
    <section class="row first">
      <h2 class="lab" id="writing"><a class="anchor" href="#writing" aria-label={t.writing + t.anchor}>{t.writing}</a></h2>
      <div>
        <h1 {...own}><span class="title">{title}</span></h1>
        <p class="lead rise" {...own}>{summary}</p>
      </div>
    </section>

    <section class="row rise" style="--d: 30ms">
      <h2 class="lab" id="published"><a class="anchor" href="#published" aria-label={t.published + t.anchor}>{t.published}</a></h2>
      <p class="val"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time>{t.minRead(post.minutes)}</p>
    </section>

    <section class="row rise" style="--d: 55ms">
      <h2 class="lab" id="post"><a class="anchor" href="#post" aria-label={t.post + t.anchor}>{t.post}</a></h2>
      <div class="val prose" {...own}><Content /></div>
    </section>

    {next && (
      <section class="row">
        <h2 class="lab" id="next"><a class="anchor" href="#next" aria-label={t.next + t.anchor}>{t.next}</a></h2>
        <p class="val">
          <a class="next" href={localized(lang, postPath(next))}><i class="dot z-cross"></i><span lang={next.lang}><span class="hl" dir={langInfo(next.lang).dir}>{next.entry.data.title}</span><LinkIcon kind="page" /></span></a><span class="or">{t.or}</span><a class="link" href="?list=posts" data-drawer="writing">{t.allPosts(posts.length)}<LinkIcon kind="list" /></a>
        </p>
      </section>
    )}
  </article>
</Base>
