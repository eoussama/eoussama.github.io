---
/** A link that leaves the site: opens in a new tab and ends in an arrow. */
interface Props {
  href: string;
  /** Read after the link text by screen readers, such as " (opens in a new tab)". */
  hint: string;
  class?: string;
}

const { href, hint, class: extra } = Astro.props;
---

<a class:list={["ext", extra]} href={href} target="_blank" rel="noopener noreferrer"><slot /><svg class="arrow" width="11" height="11" viewBox="0 0 11 11" aria-hidden="true"><path d="M2.5 8.5l6-6M3.5 2.5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="sr">{hint}</span></a>
