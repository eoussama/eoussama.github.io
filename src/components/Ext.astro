---
/**
 * A link that leaves the site: opens in a new tab and ends in an arrow. An address can
 * pass its last part as `tail`, which keeps the arrow company when the line wraps; the
 * address and its tail read as one, left to right, on a right-to-left page too.
 */
interface Props {
  href: string;
  /** Read after the link text by screen readers, such as " (opens in a new tab)". */
  hint: string;
  class?: string;
  /** The end of the link's text, kept on one line with the arrow. */
  tail?: string;
}

const { href, hint, class: extra, tail } = Astro.props;
const arrow = "<svg class=\"arrow\" width=\"11\" height=\"11\" viewBox=\"0 0 11 11\" aria-hidden=\"true\"><path d=\"M2.5 8.5l6-6M3.5 2.5h5v5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>";
---

<a class:list={["ext", extra]} href={href} target="_blank" rel="noopener noreferrer">{tail ? <span dir="ltr"><slot /><span class="ext-tail">{tail}<Fragment set:html={arrow} /></span></span> : <><slot /><Fragment set:html={arrow} /></>}<span class="sr">{hint}</span></a>
